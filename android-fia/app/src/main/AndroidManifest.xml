<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for WebView + polling + OneSignal -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service + notification permission (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot receiver — restart poller after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibrate for toast notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Wake lock for background polling when screen is off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Schedule exact alarms (for restart after task removed) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Allow scheduling via AlarmManager (for restart on task removed) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- DownloadManager — for certificate image downloads -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Request ignore battery optimizations (for reliable background
         polling on Android 6+). The user will be prompted to allow this
         on first launch. Without this, manufacturers like Xiaomi/Huawei/
         Samsung will kill the service after a few minutes. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".FIAApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FIA.Splash"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <!-- 🔥 Remove androidx.startup InitializationProvider so that
             WorkManager uses our FIAApp's Configuration.Provider instead
             of the default auto-init. Without this, WorkManager crashes
             at app startup with:
             "If an android.app.Application implements androidx.work.Configuration.Provider,
              the default androidx.startup.InitializationProvider needs to be removed
              from the AndroidManifest.xml file." -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- Disable WorkManager auto-init — we'll init it via
                 Configuration.Provider in FIAApp -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Single entry point. Splash theme shows the FIA logo + navy
             background while MainActivity inflates its content (which
             is just a WebView with a loading overlay). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FIA.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links — open fiaacademy URLs in the app instead of
                 the system browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="fiaacademy.vercel.app" />
            </intent-filter>
            <!-- Custom scheme fia:// — used by push notifications to deep-link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fia" />
            </intent-filter>
        </activity>

        <!-- ============================================================
             Foreground service — polls /api/notifications every 10s
             as a BACKUP to FCM. The primary notification mechanism is
             FIAFirebaseMessagingService (which receives FCM pushes
             from the server via Firebase Admin SDK).

             CRITICAL ATTRIBUTES for reliable background operation:
             - foregroundServiceType="dataSync" — required for
               Android 14+
             - stopWithTask="false" (default) — when the user swipes the
               app away, the service keeps running (we restart it via
               onTaskRemoved)
             - enabled="true" — system can start it
             - exported="false" — only our app can bind to it
             ============================================================ -->
        <service
            android:name=".NotificationPollService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <!-- ============================================================
             🔥 FIREBASE CLOUD MESSAGING SERVICE — the PRIMARY push
             notification mechanism. Receives pushes from Firebase even
             when the app is fully closed/force-killed.

             This is the SAME mechanism used by WhatsApp, Telegram,
             Instagram, etc. It's the industry standard for instant
             notifications on Android.

             - exported="false" — only Firebase can deliver to this service
             - We use DATA payloads (not notification payloads) so
               onMessageReceived is ALWAYS called, even in background
             ============================================================ -->
        <service
            android:name=".FIAFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Boot receiver — restart poller after reboot or app update -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
