<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Splash theme — shown for the brief moment while MainActivity
         inflates its content (just a WebView with a loading overlay).
         The window background is navy so there's no white flash. -->
    <style name="Theme.FIA.Splash" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
