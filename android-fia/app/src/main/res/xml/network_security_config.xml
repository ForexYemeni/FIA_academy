<?xml version="1.0" encoding="utf-8"?>
<!-- Network security config — HTTPS only. Cleartext traffic is
     forbidden (usesCleartextTraffic="false" in manifest). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">fiaacademy.vercel.app</domain>
        <domain includeSubdomains="true">api.telegram.org</domain>
        <domain includeSubdomains="true">firebaseinstallations.googleapis.com</domain>
        <domain includeSubdomains="true">fcm.googleapis.com</domain>
        <domain includeSubdomains="true">firebaseremoteconfig.googleapis.com</domain>
        <domain includeSubdomains="true">firebasecloudmessaging.googleapis.com</domain>
        <domain includeSubdomains="true">onesignal.com</domain>
    </domain-config>
</network-security-config>
